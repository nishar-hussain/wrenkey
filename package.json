{
  "name": "arkey",
  "version": "0.1.0",
  "private": true,
  "description": "ArKey - AI-Native Wallet & Agent Platform on Arc",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/backend",
    "build": "npm run build -w packages/backend && npm run build -w packages/sdk",
    "test": "npm run test -w packages/backend",
    "lint": "npm run lint -w packages/backend",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:generate": "npm run db:generate -w packages/backend"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
