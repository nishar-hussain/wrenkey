{
  "name": "wrankey",
  "version": "0.1.0",
  "private": true,
  "description": "WranKey - AI-Native Wallet & Agent Platform on Arc",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "wrankey-landing"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "npm run db:migrate -w packages/backend",
    "db:generate": "npm run db:generate -w packages/backend",
    "db:seed": "npm run db:seed -w packages/backend",
    "db:push": "npm run db:push -w packages/backend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "turbo": "^2.10.11"
  },
  "dependencies": {
    "@metamask/keyring-controller": "^27.1.0"
  }
}
