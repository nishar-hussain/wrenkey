generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users      User[]
  wallets    Wallet[]
  policies   Policy[]
  agents     Agent[]
  apiKeys    ApiKey[]
  webhooks   Webhook[]
  auditLogs  AuditLog[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String?
  email     String?
  phone     String?
  role      String   @default("DEVELOPER")
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org          Organization   @relation(fields: [orgId], references: [id])
  sessions     Session[]
  wallets      Wallet[]
  agents       Agent[]
  auditLogs    AuditLog[]
  webhooks     Webhook[]
  authenticators Authenticator[]

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@map("users")
}

model Authenticator {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String   // EMAIL, PHONE, OAUTH_GOOGLE, PASSKEY, WALLET
  credentialId   String?  @map("credential_id")
  credentialData Json?    @map("credential_data")
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authenticators")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  type      String   @default("READ_WRITE") // READ_ONLY, READ_WRITE
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  keyHash     String   @map("key_hash")
  keyPrefix   String   @map("key_prefix")
  permissions String[] @default([])
  allowedIps  String[] @default([]) @map("allowed_ips")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@map("api_keys")
}

model Wallet {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  ownerType String   @map("owner_type") // USER, BACKEND, AGENT
  ownerId   String   @map("owner_id")
  userId    String?  @map("user_id")
  name      String
  tags      String[] @default([])
  encryptedSeed String @map("encrypted_seed")
  status    String   @default("ACTIVE") // ACTIVE, DELETED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org      Organization     @relation(fields: [orgId], references: [id])
  user     User?            @relation(fields: [userId], references: [id])
  accounts WalletAccount[]

  @@map("wallets")
}

model WalletAccount {
  id             String   @id @default(uuid())
  walletId       String   @map("wallet_id")
  chain          String   @default("arc") // arc, ethereum, etc.
  address        String
  derivationPath String   @map("derivation_path")
  index          Int
  createdAt      DateTime @default(now()) @map("created_at")

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("wallet_accounts")
}

model Transaction {
  id          String   @id @default(uuid())
  accountId   String   @map("account_id")
  orgId       String   @map("org_id")
  txHash      String?  @map("tx_hash")
  chain       String   @default("arc")
  to          String
  value       String   // in wei-like units as string for precision
  gasLimit    String?  @map("gas_limit")
  maxFeePerGas String? @map("max_fee_per_gas")
  data        String?  // calldata
  status      String   @default("PENDING") // PENDING, SIGNED, BROADCAST, CONFIRMED, FAILED
  signedTx    String?  @map("signed_tx")
  error       String?
  createdAt   DateTime @default(now()) @map("created_at")
  confirmedAt DateTime? @map("confirmed_at")

  account WalletAccount @relation(fields: [accountId], references: [id])

  @@map("transactions")
}

model Policy {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  effect    String   // EFFECT_ALLOW, EFFECT_DENY
  conditions Json
  consensus String   @default("ANY") // ANY, ALL, REQUIRES_CONSENSUS
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@map("policies")
}

model Agent {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  name      String
  apiKeyId  String?  @map("api_key_id")
  status    String   @default("ACTIVE") // ACTIVE, REVOKED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@map("agents")
}

model Webhook {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  userId      String?  @map("user_id")
  url         String
  events      String[] @default([])
  hmacSecret  String   @map("hmac_secret")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User?        @relation(fields: [userId], references: [id])

  @@map("webhooks")
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String?  @map("user_id")
  action    String   // LOGIN, SIGNUP, WALLET_CREATE, TX_SIGN, POLICY_EVAL, etc.
  resource  String?  // wallet_id, transaction_id, etc.
  details   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User?        @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@map("audit_logs")
}
