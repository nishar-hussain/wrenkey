generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  parentOrgId String?  @map("parent_org_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent         Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children       Organization[] @relation("OrgHierarchy")
  users          User[]
  wallets        Wallet[]
  policies       Policy[]
  agents         Agent[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  webhookDeliveries WebhookDelivery[]
  auditLogs      AuditLog[]
  spendingLimits SpendingLimit[]
  approvalRequests ApprovalRequest[]
  tags           Tag[]
  config         OrgConfig?
  invoices       Invoice[]
  contractInterfaces ContractInterface[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String?
  email     String?
  phone     String?
  role      String   @default("DEVELOPER")
  tags      String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org            Organization    @relation(fields: [orgId], references: [id])
  sessions       Session[]
  wallets        Wallet[]
  agents         Agent[]
  auditLogs      AuditLog[]
  webhooks       Webhook[]
  authenticators Authenticator[]

  @@unique([orgId, email])
  @@unique([orgId, phone])
  @@index([email])
  @@index([phone])
  @@index([orgId, role])
  @@map("users")
}

model Authenticator {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  type           String
  credentialId   String?  @map("credential_id")
  credentialData Json?    @map("credential_data")
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authenticators")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  type      String   @default("READ_WRITE")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  permissions String[]  @default([])
  allowedIps  String[]  @default([]) @map("allowed_ips")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@map("api_keys")
}

model Wallet {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  ownerType     String   @map("owner_type")
  ownerId       String   @map("owner_id")
  userId        String?  @map("user_id")
  name          String
  tags          String[] @default([])
  encryptedSeed String   @map("encrypted_seed")
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org      Organization     @relation(fields: [orgId], references: [id])
  user   User?        @relation(fields: [userId], references: [id])
  accounts WalletAccount[]
  spendingLimits SpendingLimit[]

  @@index([orgId])
  @@index([userId])
  @@index([ownerType, ownerId])
  @@index([status])
  @@map("wallets")
}

model Chain {
  id               String   @id @default(uuid())
  name             String   @unique
  chainId          Int      @unique @map("chain_id")
  rpcUrl           String   @map("rpc_url")
  nativeCurrency   String   @default("ETH") @map("native_currency")
  symbol           String   @default("ETH")
  blockExplorerUrl String?  @map("block_explorer_url")
  derivationPath   String   @default("m/44'/60'/0'/0") @map("derivation_path")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  accounts        WalletAccount[]
  spendingLimits  SpendingLimit[]

  @@map("chains")
}

model WalletAccount {
  id             String   @id @default(uuid())
  walletId       String   @map("wallet_id")
  chainId        String   @map("chain_id")
  address        String
  derivationPath String   @map("derivation_path")
  index          Int
  createdAt      DateTime @default(now()) @map("created_at")

  wallet       Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain        Chain         @relation(fields: [chainId], references: [id])
  transactions Transaction[]

  @@index([walletId])
  @@index([chainId])
  @@index([address])
  @@map("wallet_accounts")
}

model SpendingLimit {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  walletId    String?  @map("wallet_id")
  chainId     String?  @map("chain_id")
  name        String
  maxPerTx    String?  @map("max_per_tx")
  maxDaily    String?  @map("max_daily")
  maxMonthly  String?  @map("max_monthly")
  allowlist   String[] @default([])
  denylist    String[] @default([])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org   Organization @relation(fields: [orgId], references: [id])
  wallet Wallet?     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  chain  Chain?      @relation(fields: [chainId], references: [id])

  @@map("spending_limits")
}

model ApprovalRequest {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  transactionId String @map("transaction_id")
  requestedBy String   @map("requested_by")
  approvedBy  String[] @default([])
  rejectedBy  String[] @default([])
  requiredApprovals Int @default(2) @map("required_approvals")
  status      String   @default("PENDING")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@map("approval_requests")
}

model Transaction {
  id           String    @id @default(uuid())
  accountId    String    @map("account_id")
  orgId        String    @map("org_id")
  txHash       String?   @map("tx_hash")
  chain        String    @default("sepolia")
  to           String
  value        String
  nonce        Int?
  gasLimit     String?   @map("gas_limit")
  maxFeePerGas String?   @map("max_fee_per_gas")
  maxPriorityFeePerGas String? @map("max_priority_fee_per_gas")
  data         String?
  status       String    @default("PENDING")
  signedTx     String?   @map("signed_tx")
  replacementFor String? @map("replacement_for")
  error        String?
  riskScore    Int?      @map("risk_score")
  sponsored    Boolean   @default(false)
  createdAt    DateTime  @default(now()) @map("created_at")
  confirmedAt  DateTime? @map("confirmed_at")

  account WalletAccount @relation(fields: [accountId], references: [id])

  @@index([orgId, createdAt])
  @@index([accountId])
  @@index([status])
  @@index([txHash])
  @@index([replacementFor])
  @@map("transactions")
}

model Policy {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  name       String
  effect     String
  conditions Json
  consensus  String   @default("ANY")
  priority   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, active, priority])
  @@map("policies")
}

model Agent {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  name      String
  apiKeyId  String?  @map("api_key_id")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@map("agents")
}

model Webhook {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  userId     String?  @map("user_id")
  url        String
  events     String[] @default([])
  hmacSecret String   @map("hmac_secret")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User?        @relation(fields: [userId], references: [id])
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String?  @map("user_id")
  action    String
  resource  String?
  details   Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  org  Organization @relation(fields: [orgId], references: [id])
  user User?        @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model WebhookDelivery {
  id            String    @id @default(uuid())
  webhookId     String    @map("webhook_id")
  orgId         String    @map("org_id")
  event         String
  payload       Json
  status        String    @default("PENDING")
  attemptCount  Int       @default(0) @map("attempt_count")
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  org     Organization @relation(fields: [orgId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([webhookId])
  @@map("webhook_deliveries")
}

model Tag {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  name      String
  type      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, name, type])
  @@map("tags")
}

model OrgConfig {
  id        String   @id @default(uuid())
  orgId     String   @unique @map("org_id")
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@map("org_configs")
}

model Invoice {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  number    String
  period    String
  plan      String
  amount    String
  status    String   @default("pending")
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, period])
  @@unique([number])
  @@index([orgId])
  @@map("invoices")
}

model ContractInterface {
  id            String   @id @default(uuid())
  orgId         String   @map("org_id")
  name          String
  notes         String   @default("")
  address       String   @default("")
  interfaceType String   @default("custom") @map("interface_type")
  abi           Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("contract_interfaces")
}
