# ─── WranKey Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# In development, sensible defaults are provided for most fields.

# ─── Server ────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wrankey

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth / JWT ────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-32chars-long-for-dev-only
ENCRYPTION_KEY=dev-encryption-key-must-be-32chars

# ─── Session ───────────────────────────────────────────────────────────
# Session expiry in seconds (dev: 30 days, prod: 1 hour recommended)
SESSION_EXPIRY_SECONDS=2592000

# ─── API Keys ──────────────────────────────────────────────────────────
# Default expiry for new API keys in days
API_KEY_EXPIRY_DAYS=365

# ─── OTP ───────────────────────────────────────────────────────────────
# OTP expiry in seconds (default: 5 minutes)
OTP_EXPIRY_SECONDS=300

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ─── Blockchain / RPC ──────────────────────────────────────────────────
# Sepolia testnet (default dev chain)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_CHAIN_ID=11155111

# Arc blockchain (production)
# ARC_RPC_URL=https://rpc.arc.network
# ARC_CHAIN_ID=1234

# ─── Email / SMTP ──────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@wrankey.io

# ─── SMS / Twilio ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── OAuth ─────────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ─── WebAuthn / Passkeys ───────────────────────────────────────────────
WEBAUTHN_RP_ID=localhost

# ─── Webhooks ──────────────────────────────────────────────────────────
WEBHOOK_HMAC_SECRET=dev-webhook-hmac-secret

# ─── Gas Sponsorship ───────────────────────────────────────────────────
# Set to "true" to enable gasless transactions for users
GAS_SPONSORSHIP_ENABLED=false
# Maximum amount (in native currency) to sponsor per transaction
GAS_SPONSORSHIP_MAX_AMOUNT=0.01
# Wallet ID of the sponsor (must exist in the system)
GAS_SPONSORSHIP_WALLET_ID=

# ─── Risk Assessment ───────────────────────────────────────────────────
# Percentage of average value that triggers high-value flag (0-100)
RISK_HIGH_VALUE_PCT=80
# Risk score threshold for requiring approval (0-100)
RISK_SCORE_THRESHOLD=70
# Velocity check: time window in seconds
VELOCITY_WINDOW_SECONDS=3600
# Max transactions allowed per velocity window
MAX_TX_PER_WINDOW=50

# ─── Transaction Retry ─────────────────────────────────────────────────
# Max number of retry attempts per transaction
TX_MAX_RETRIES=3
# Base delay between retries in milliseconds
TX_RETRY_BASE_DELAY_MS=1000

# ─── Chain RPC URLs ────────────────────────────────────────────────────
# Each chain's RPC endpoint (used by chain seeding + transaction broadcasting)
ETH_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org
ARC_RPC_URL=https://rpc.arc.network
ARC_CHAIN_ID=1234
ARC_EXPLORER_URL=

# ─── Stellar ─────────────────────────────────────────────────────────────
# Horizon REST API endpoints (used by the stellar-testnet / stellar-pubnet chains)
STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PUBNET_HORIZON_URL=https://horizon.stellar.org
# Optional block explorer URL overrides
STELLAR_TESTNET_EXPLORER_URL=https://stellar.expert/explorer/testnet
STELLAR_PUBNET_EXPLORER_URL=https://stellar.expert/explorer/public
# Network passphrases are immutable protocol constants; override only for local sandboxes.
STELLAR_TESTNET_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_PUBNET_PASSPHRASE=Public Global Stellar Network ; September 2015

# ─── Webhook Retry ─────────────────────────────────────────────────────
# Max retry attempts for failed webhook deliveries
WEBHOOK_MAX_RETRIES=5
# Initial retry delay in milliseconds (doubles each attempt)
WEBHOOK_RETRY_BASE_DELAY_MS=60000
# Maximum retry delay in milliseconds
WEBHOOK_RETRY_MAX_DELAY_MS=3600000

# ─── WVC (Verifiable Compute) ──────────────────────────────────────────
# When set, /wvc/deployments/:id/invoke forwards to this Host Agent endpoint
# (the vsock proxy on the parent EC2 instance). Empty in dev => invoke returns
# a clear "no enclave" error. (PRD §20)
WVC_ENCLAVE_ENDPOINT=
# Timeout for enclave invoke requests in milliseconds
WVC_INVOKE_TIMEOUT_MS=30000
# Allow local-dev-v1 proofs (simulated enclave) — dev/test only. (PRD §16)
WVC_ALLOW_LOCAL_PROOFS=true
# Route wallet seed generation + transaction signing through a WVC enclave
# deployment. Set to a LIVE deployment ID to enable; leave empty to use the
# in-process ethers.js signer. (PRD §25)
WVC_WALLET_SIGNER_DEPLOYMENT_ID=
