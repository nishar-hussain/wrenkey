# ─── Database & Cache ─────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wrankey
REDIS_URL=redis://localhost:6379

# ─── Core ────────────────────────────────────────────
JWT_SECRET=generate-a-secure-random-string-here
ENCRYPTION_KEY=32-character-encryption-key-here
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ─── Sessions & Auth ─────────────────────────────────
SESSION_EXPIRY_SECONDS=3600
API_KEY_EXPIRY_DAYS=365
OTP_EXPIRY_SECONDS=300

# ─── Default Chain (Sepolia) ─────────────────────────
SEPOLIA_RPC_URL=https://rpc.sepolia.org
SEPOLIA_CHAIN_ID=11155111

# ─── Other Chain RPCs (optional) ─────────────────────
ETH_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org

# ─── Platform Wallet (gas sponsorship, fees, etc.) ───
# Sepolia testnet private key with 0x prefix
# Generate with: openssl rand -hex 32
# Fund it at: https://sepoliafaucet.com
PLATFORM_PRIVATE_KEY=

# ─── Gas Sponsorship ─────────────────────────────────
GAS_SPONSORSHIP_ENABLED=false
GAS_SPONSORSHIP_MAX_AMOUNT=0.01
GAS_SPONSORSHIP_WALLET_ID=

# ─── Transaction Risk ────────────────────────────────
RISK_HIGH_VALUE_PCT=80
RISK_SCORE_THRESHOLD=70
VELOCITY_WINDOW_SECONDS=3600
MAX_TX_PER_WINDOW=50

# ─── Transaction Retry ───────────────────────────────
TX_MAX_RETRIES=3
TX_RETRY_BASE_DELAY_MS=1000

# ─── Email (SMTP) ────────────────────────────────────
# Leave empty for dev mode (OTP shown in terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@wrankey.io

# ─── SMS (Twilio) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── OAuth (Google) ──────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ─── Webhooks ────────────────────────────────────────
WEBHOOK_HMAC_SECRET=dev-webhook-secret

# ─── WebAuthn / Passkeys ─────────────────────────────
WEBAUTHN_RP_ID=localhost
