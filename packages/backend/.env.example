DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wrankey
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-jwt-secret
ENCRYPTION_KEY=dev-encryption-key-32chars-here
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
ARC_RPC_URL=https://rpc.arc.network
ARC_CHAIN_ID=1234
SESSION_EXPIRY_SECONDS=3600
API_KEY_EXPIRY_DAYS=365
OTP_EXPIRY_SECONDS=300
CORS_ORIGIN=http://localhost:5173

# ─── Email (SMTP) ──────────────────────────────────────
# Gmail: Set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Then generate an App Password at https://myaccount.google.com/apppasswords
# and paste it below as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_EMAIL=no-reply@wrankey.io

# Leave SMTP_PASS empty to use dev mode (OTP shown in UI & server logs)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
WEBHOOK_HMAC_SECRET=dev-webhook-secret
WEBAUTHN_RP_ID=localhost
